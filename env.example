# Root environment template for local development on Windows / VS Code.
# Copy this file to `.env` in the same folder and adjust any values.

# PostgreSQL connection (default matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizzhive

# API server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-in-production
APP_URL=http://localhost:5173

# Frontend dev server
BASE_PATH=/
API_URL=http://localhost:3000

# Payment providers (optional for local development)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
