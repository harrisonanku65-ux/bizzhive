# Root environment template for local development on Windows / VS Code.
# Copy this file to `.env` in the same folder and adjust any values.

# PostgreSQL connection (default matches docker-compose.yml).
# Use 127.0.0.1 rather than localhost — on Windows, Node resolves "localhost"
# to IPv6 (::1) first, and if Docker Desktop's port forwarding doesn't answer
# cleanly there, every query hangs for ~30s before failing with ECONNRESET.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bizzhive

# API server
PORT=3000
NODE_ENV=development
# Generate a long random string for production. Anyone with this value can
# forge session cookies, including admin sessions.
SESSION_SECRET=change-this-in-production
APP_URL=http://localhost:5173

# Frontend dev server
BASE_PATH=/
API_URL=http://localhost:3000

# Payment providers (optional for local development)
# Without these the app runs in demo mode: orders are marked paid without
# money moving, and payouts/refunds are recorded as "demo".
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Paystack subscription plan codes for the seller tiers. Create the plans in
# your Paystack dashboard (GHS 80/month and GHS 200/month) and paste the
# resulting plan codes here. Vendor upgrades fail without them.
PAYSTACK_PRO_PLAN_CODE=
PAYSTACK_PREMIUM_PLAN_CODE=

# Cloudinary — required for ALL file uploads (course thumbnails, product
# files, audio previews). Uploads fail with a 502 if these are unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Escrow hold period, in minutes, before payment auto-releases to the seller
# when the buyer never confirms. Defaults to 20160 (14 days) if unset or blank.
#
# 20160 (14 days) is chosen to match the consumer cancellation/cooling-off
# window in Ghana's Electronic Transactions Act, 2008 (Act 772) s.49 (14 days
# for goods after receipt, 7 days for services) — that section governs buyer
# cancellation rights, not escrow release specifically, so treat this as an
# informed default rather than a confirmed legal requirement. Get this
# reviewed by a lawyer familiar with Ghanaian e-commerce law before relying
# on it for a live business.
#
# Set to something small (e.g. 5) when testing.
DELIVERY_AUTO_RELEASE_MINUTES=20160

# Transactional email (Resend). Without RESEND_API_KEY nothing is sent —
# messages are logged instead, so you can develop without an account.
# MAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=
MAIL_FROM=BizzHive <noreply@bizzhivegh.com>

# Where dispute and escalation alerts go. Leave blank to disable.
ADMIN_NOTIFICATION_EMAIL=

# Set to "none" only if the API and frontend are served from DIFFERENT
# domains in production (requires HTTPS). Otherwise leave as "lax".
SESSION_COOKIE_SAMESITE=lax
